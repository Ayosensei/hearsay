FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# Leave blank for local Docker; use the database user shown by Cloud.
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
GEMINI_API_KEY=
# Choose a currently available Flash model in Google AI Studio before enabling live.
GEMINI_MODEL=
# Templates need no API key; set live with a Gemini key/model for generated dialogue.
HEARSAY_LLM=off
# The web demo calls the local graph engine. Set mock only for fixture development.
NEXT_PUBLIC_HEARSAY_MODE=live
